{
  "name": "sprimault/ormeau-doctrine",
  "description": "Génère et synchronise des entités Doctrine à partir d'un calque Ormeau",
  "type": "symfony-bundle",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "nikic/php-parser": "^5.0",
    "symfony/console": "^5.4 || ^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0 || ^8.0",
    "doctrine/orm": "^2.14 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Ormeau\\Doctrine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ormeau\\Doctrine\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "style": "php-cs-fixer fix --dry-run --diff"
  },
  "config": {
    "sort-packages": true
  }
}
