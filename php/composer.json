{
  "name": "sprimault/ormeau-doctrine",
  "description": "Génère et synchronise des entités Doctrine à partir d'un calque Ormeau",
  "type": "symfony-bundle",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3",
    "nikic/php-parser": "^5.0",
    "symfony/console": "^7.0",
    "symfony/framework-bundle": "^7.0",
    "doctrine/orm": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Ormeau\\Doctrine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ormeau\\Doctrine\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
