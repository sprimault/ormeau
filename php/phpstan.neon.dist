parameters:
    level: 8
    paths:
        - src
        - tests

    # Les attendus de génération sont du code produit pour une application, pas
    # du code du paquet : leurs classes de base ne sont pas chargeables ici.
    excludePaths:
        - tests/Generation/attendus

    # Un docblock n'est pas une garantie, et ce paquet lit précisément les
    # entités d'un client : @var string sur une propriété qui contient autre
    # chose est le cas normal, pas l'exception.
    treatPhpDocTypesAsCertain: false

    # La plage que le paquet promet. Sans elle, PHPStan analyse pour la version
    # qui l'exécute et laisse passer une classe readonly ou une constante typée
    # que PHP 8.1 refuse.
    phpVersion:
        min: 80100
        max: 80499
